# Atlas deployment settings (non-secret). Copy to deploy/.env and edit.
#   cp .env.example .env
# Secrets do NOT go here: `atlas-admin init` generates them under ATLAS_SECRETS_DIR.
# Full reference: docs/SELF_HOSTING.md#configuration-reference

# Public HTTPS URL of Atlas. Replace the placeholder: Atlas refuses to start with example.com.
ATLAS_PUBLIC_URL=https://atlas.example.com

# Bundled identity provider (Kanidm; ADR-001). Its own HTTPS hostname, different from
# ATLAS_PUBLIC_URL. Replace the placeholder. For bring-your-own OIDC instead, remove
# bundled-idp from COMPOSE_PROFILES and delete ATLAS_IDP_PUBLIC_URL (SELF_HOSTING).
ATLAS_IDP_PUBLIC_URL=https://id.example.com
COMPOSE_PROFILES=bundled-idp
# External Docker volume for the IdP's database (install.sh creates it).
ATLAS_IDP_VOLUME=atlas_idp
# Private subnet of the internal idp-front network (atlas-proxy + idp only); Kanidm
# trusts X-Forwarded-For from it. Change it only if it collides with one of your
# networks: pick any private /28 that is free on this host, then run
# `docker compose down && ./install.sh` (never `down -v`).
ATLAS_IDP_FRONT_SUBNET=10.249.73.0/28
# Kanidm online backups (cron: minute hour day month weekday; UTC) and how many to keep.
ATLAS_IDP_BACKUP_SCHEDULE="0 * * * *"
ATLAS_IDP_BACKUP_VERSIONS=24

# Where the proxy listens on the host. Keep loopback when a tunnel or reverse proxy
# runs on the same host.
ATLAS_BIND_ADDRESS=127.0.0.1
ATLAS_HTTP_PORT=8080

# Time zone for container clocks, logs and scheduled jobs. Stored data is always UTC.
TZ=UTC

# Host paths. Absolute paths are recommended in production.
ATLAS_SECRETS_DIR=./secrets
ATLAS_BACKUP_DIR=./backups

# Atlas image tag. `local` is built from this checkout by `docker compose up`.
ATLAS_IMAGE_TAG=local

# External Docker volume for Postgres data (create it once: docker volume create atlas_pgdata).
ATLAS_PGDATA_VOLUME=atlas_pgdata

# Client IP header from the component in front (CF-Connecting-IP with Cloudflare Tunnel),
# trusted only from these peers. With the default loopback bind, empty means loopback
# plus the Docker gateway. Any other bind REQUIRES this list (the proxy refuses to start
# without it): with Docker's userland proxy every connection arrives from the gateway.
ATLAS_REAL_IP_HEADER=X-Forwarded-For
ATLAS_TRUSTED_PROXY_CIDRS=

# Proxy limits.
ATLAS_MAX_BODY_SIZE=10m
ATLAS_RATE_LIMIT_AUTH=10r/m
ATLAS_RATE_LIMIT_API=20r/s
# Credential submissions to the bundled IdP, per client IP.
ATLAS_RATE_LIMIT_IDP_AUTH=30r/m

# Backup retention.
ATLAS_BACKUP_KEEP_DAILY=7
ATLAS_BACKUP_KEEP_WEEKLY=4
