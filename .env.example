# Copy to .env (never commit .env) and fill in every value.
# Atlas refuses to start without a strong SECRET_KEY.

# JWT signing key: at least 43 characters of random data. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# MinIO server root credentials (used by the minio service in docker-compose.yml).
# Generate the password with: python -c "import secrets; print(secrets.token_urlsafe(24))"
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Only needed when STORAGE_BACKEND=minio: credentials Atlas uses to talk to MinIO
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
